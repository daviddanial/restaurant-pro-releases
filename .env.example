# Sample local env — copy to .env and adjust. Do not commit real secrets.

SPRING_PROFILES_ACTIVE=local,api,worker
SERVER_PORT=38471

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/telerad
SPRING_DATASOURCE_USERNAME=telerad
SPRING_DATASOURCE_PASSWORD=telerad

SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_USERNAME=telerad
SPRING_RABBITMQ_PASSWORD=telerad

TELERAD_S3_ENDPOINT=http://localhost:9000
TELERAD_S3_ACCESS_KEY=minioadmin
TELERAD_S3_SECRET_KEY=minioadmin
TELERAD_S3_BUCKET=telerad

TELERAD_JWT_SECRET=change-me-in-production-use-a-long-secret-key-32chars
TELERAD_SCP_ENABLED=false
