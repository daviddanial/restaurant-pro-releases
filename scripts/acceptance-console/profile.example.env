# TeleRad acceptance suite — ONE profile file per site.
#
# A new site copies this to a profile file (recommended: /home/hermes/.telerad-acceptance.env)
# and edits ONLY the values below. Nothing in the tools is site-specific: if a run fails after
# a value changed, that value is the first suspect (see MIGRATION.md).
#
# Load it before starting the console:
#     set -a; . /home/hermes/.telerad-acceptance.env; set +a
# or, in systemd, point the service at it with `EnvironmentFile=`.
#
# Format: plain KEY=VALUE (the console's own parser, negative_suite.py and the selftests read
# it directly and never `source` it — a value with spaces like TELERAD_HOSPITAL_NAME is fine).
# Real environment variables always win over this file.
#
# Defaults shown in the comments are the demo deployment's values, NOT site requirements.

# ---------------------------------------------------------------------------
# 1 · TeleRad API (Stage 2/3 ask TeleRad itself)
# ---------------------------------------------------------------------------
# Base URL of the TeleRad REST API as reachable FROM the console host.
TELERAD_API=http://127.0.0.1:18080

# Portal / SPA origin used for the viewer-render check (opens /studies/<id>) and
# for the deep-links the console shows (portal_urls are derived from this value).
TELERAD_APP_URL=https://telerad.13.140.56.88.sslip.io

# API login the console uses for the admin-only lookups. Change for the new site.
TELERAD_ADMIN_EMAIL=admin@telerad.local
TELERAD_ADMIN_PASSWORD=password

# Seed accounts for the Stage-3 clinical workflow (P2): the radiologist that claims
# and signs, the hospital user that dispatches and reads the delivered PDF back.
TELERAD_RADIOLOGIST_EMAIL=rad@telerad.local
TELERAD_RADIOLOGIST_PASSWORD=password
TELERAD_HOSPITAL_USER_EMAIL=staff@demohosp.local
TELERAD_HOSPITAL_USER_PASSWORD=password

# The tenant (hospital row) the suite sends studies *for*. Must be the id/name of the
# hospital whose DICOM node (below) the SCP maps the calling AE to.
TELERAD_HOSPITAL_ID=11111111-1111-1111-1111-111111111111
TELERAD_HOSPITAL_NAME=Demo General Hospital

# ---------------------------------------------------------------------------
# 2 · DICOM endpoint (Stage 1) — the PACS/SCP that receives the study
# ---------------------------------------------------------------------------
# Where TeleRad's storage SCP listens, as reachable FROM the console host.
# In the demo the SCP is bound to loopback, so the console runs on the same host
# (or over an SSH tunnel); at a real site point this at the hospital PACS.
PACS_HOST=127.0.0.1
PACS_PORT=11112

# Must equal the SCP's configured AE title. Demo: TELERAD (the app default is
# TELERAD_SCP and the deployment overrides it — verify at the new site).
PACS_CALLED_AE=TELERAD

# Must be an ACTIVE row in the dicom_nodes table: the SCP maps the calling AE to a
# tenant and refuses an unknown caller. Demo seeded nodes: DEMOHOSP_PACS, CITYMED_PACS.
PACS_CALLING_AE=DEMOHOSP_PACS

# Fixture header read by the Stage-1 connection test (dry-run only, stores nothing).
# Any readable study archive under FIXTURES_DIR works.
TELERAD_CONNECTION_FIXTURE=B/pacs-B.zip

# ---------------------------------------------------------------------------
# 3 · Read-only database (Stage-2 corroboration)
# ---------------------------------------------------------------------------
# SELECT-only role over the study tables — deliberately NOT the app's credentials.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=telerad
DB_USER=telerad_test_ro
DB_PASSWORD=change-me

# ---------------------------------------------------------------------------
# 4 · Browserless (P1 viewer-render check)
# ---------------------------------------------------------------------------
BROWSERLESS_URL=http://127.0.0.1:3000
# Empty means the viewer-render check WARNS instead of passing — never a silent green.
BROWSERLESS_TOKEN=

# ---------------------------------------------------------------------------
# 5 · Paths and interpreter on the console host
# ---------------------------------------------------------------------------
FIXTURES_DIR=/home/hermes/dicom-fixtures
SENDER=/home/hermes/telerad-repo/scripts/pacs-simulator/send-study.py
PYTHON=/opt/dicom-tools/bin/python

# Where the tools look for THIS profile file when run standalone (selftests,
# negative_suite.py, workflow.py). The console service gets the values from its
# environment instead. Point it at the site's profile if not the default path.
TELERAD_ACCEPTANCE_ENV=/home/hermes/.telerad-acceptance.env
