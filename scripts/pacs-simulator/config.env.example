# TeleRad PACS simulator defaults.
#
# Copy to config.env and adjust. config.env is machine-local: do not commit one with
# real hostnames or credentials. Command-line flags passed to send-study.sh always
# take precedence over anything here.

# Where the TeleRad DICOM SCP listens. In the VPS deployment the SCP port is bound to
# loopback only (127.0.0.1:11112), so the simulator has to run on the same host, or
# reach it through an SSH tunnel.
PACS_HOST=127.0.0.1
PACS_PORT=11112

# Must match the SCP's configured AE title. The app default is TELERAD_SCP, but the
# VPS deployment overrides it with TELERAD_SCP_AE_TITLE=TELERAD — check before sending:
#   docker inspect tele2-dicom-scp-1 --format '{{range .Config.Env}}{{println .}}{{end}}' | grep AE_TITLE
PACS_CALLED_AE=TELERAD

# Must be an active row in the dicom_nodes table: the SCP maps the calling AE to a
# tenant, and an unknown caller is refused. Seeded nodes: DEMOHOSP_PACS, CITYMED_PACS.
PACS_CALLING_AE=DEMOHOSP_PACS
