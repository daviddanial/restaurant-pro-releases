# TeleRad PACS simulator — one config file per site.
#
# Copy to config.env and adjust. config.env is machine-local: do not commit one with
# real hostnames or credentials. Command-line flags passed to send-study.sh always
# take precedence over anything here; the environment is the fallback when config.env
# has no value.
#
# The acceptance console and the portability pack use the SAME variable names
# (PACS_HOST/PORT/CALLED_AE/CALLING_AE), so a site edits its values once, in
# scripts/acceptance-console/profile.example.env, and both tools follow. This file
# exists so the simulator can also be driven on its own, without the console.

# ---------------------------------------------------------------------------
# DICOM endpoint
# ---------------------------------------------------------------------------
# Where the receiving SCP listens. In the demo deployment the SCP port is bound to
# loopback only (127.0.0.1:11112), so the simulator runs on the same host, or reaches
# it through an SSH tunnel. At a real site this is the PACS/SCP host.
PACS_HOST=127.0.0.1
PACS_PORT=11112

# Must match the SCP's configured AE title. The app default is TELERAD_SCP, but the
# demo deployment overrides it with TELERAD_SCP_AE_TITLE=TELERAD — verify before sending:
#   docker inspect tele2-dicom-scp-1 --format '{{range .Config.Env}}{{println .}}{{end}}' | grep AE_TITLE
PACS_CALLED_AE=TELERAD

# Must be an active row in the dicom_nodes table: the SCP maps the calling AE to a
# tenant, and an unknown caller is refused. Demo seeded nodes: DEMOHOSP_PACS, CITYMED_PACS.
PACS_CALLING_AE=DEMOHOSP_PACS

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Python with pydicom + pynetdicom. Leave unset to use python3 (send-study.sh installs
# the deps from scripts/requirements-dicom.txt if they are missing).
#PYTHON=/opt/dicom-tools/bin/python
